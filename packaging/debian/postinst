#!/usr/bin/env bash
set -euo pipefail

service_user="dasobjectstore"
service_group="dasobjectstore"
admin_group="dasobjectstore-admin"
shared_monas_group="mnemosyne-pistis-das"
managed_root="/srv/dasobjectstore"
workspace_aggregate_root="$managed_root/workspaces"
product_root="/opt/dasobjectstore"

ensure_group() {
  if ! getent group "$service_group" >/dev/null; then
    groupadd --system "$service_group"
  fi
  if ! getent group "$admin_group" >/dev/null; then
    groupadd --system "$admin_group"
  fi
  if ! getent group "$shared_monas_group" >/dev/null; then
    groupadd --system "$shared_monas_group"
  fi
}

ensure_user() {
  if ! id -u "$service_user" >/dev/null 2>&1; then
    useradd --system \
      --gid "$service_group" \
      --home-dir /var/lib/dasobjectstore \
      --no-create-home \
      --shell /usr/sbin/nologin \
      "$service_user"
  fi
}

ensure_container_runtime_access() {
  if getent group docker >/dev/null; then
    usermod -aG docker "$service_user"
  else
    cat >&2 <<WARNING
DASObjectStore formal PDF reporting requires access to the Docker API, but the
docker group does not exist. Install or repair Docker, then add $service_user to
the docker group and restart dasobjectstore-server.service.
WARNING
  fi
}

ensure_web_admin_peer_membership() {
  usermod -aG "$admin_group" "$service_user"
}

ensure_workspace_aggregate_config() {
  local config="/etc/dasobjectstore/workspace-host.json"
  local temporary
  [[ -f "$config" ]] || return 0
  grep -q '"aggregate_root"' "$config" && return 0
  temporary="$(mktemp "${config}.tmp.XXXXXX")"
  sed '/"schema_version"[[:space:]]*:[[:space:]]*1[[:space:]]*,/a\
  "aggregate_root": "/srv/dasobjectstore/workspaces",' "$config" >"$temporary"
  if grep -q '"aggregate_root"' "$temporary"; then
    chown root:root "$temporary"
    chmod 0640 "$temporary"
    mv -f "$temporary" "$config"
  else
    rm -f "$temporary"
    printf >&2 'DASObjectStore retained workspace broker config without aggregate_root; add it explicitly before workspace provisioning.\n'
  fi
}

ensure_workspace_nfs_config() {
  local config="/etc/dasobjectstore/workspace-host.json"
  local temporary
  [[ -f "$config" ]] || return 0
  grep -q '"nfs_clients"' "$config" && return 0
  temporary="$(mktemp "${config}.tmp.XXXXXX")"
  sed '/"aggregate_root"[[:space:]]*:/a\
  "nfs_clients": {},' "$config" >"$temporary"
  if grep -q '"nfs_clients"' "$temporary"; then
    chown root:root "$temporary"
    chmod 0640 "$temporary"
    mv -f "$temporary" "$config"
  else
    rm -f "$temporary"
    printf >&2 'DASObjectStore retained workspace broker config without nfs_clients; add the root-owned registry explicitly before NFS attachment.\n'
  fi
}

ensure_workspace_metadata_config() {
  local config="/etc/dasobjectstore/workspace-host.json"
  local temporary
  [[ -f "$config" ]] || return 0
  grep -q '"live_metadata_path"' "$config" && return 0
  temporary="$(mktemp "${config}.tmp.XXXXXX")"
  sed '/"schema_version"[[:space:]]*:[[:space:]]*1[[:space:]]*,/a\
  "live_metadata_path": "/srv/dasobjectstore/ssd/.dasobjectstore/live.sqlite",' "$config" >"$temporary"
  if grep -q '"live_metadata_path"' "$temporary"; then
    chown root:root "$temporary"
    chmod 0640 "$temporary"
    mv -f "$temporary" "$config"
  else
    rm -f "$temporary"
    printf >&2 'DASObjectStore retained workspace broker config without live_metadata_path; add it before materialization.\n'
  fi
}

ensure_report_provider() {
  local wrapper="/usr/libexec/dasobjectstore/gnostikon-workflow-control"
  if [[ ! -x "$wrapper" ]]; then
    return 0
  fi

  if "$wrapper" prewarm-report-provider >/dev/null 2>&1; then
    printf 'DASObjectStore formal PDF report provider is installed and prewarmed.\n'
    return 0
  fi

  cat >&2 <<WARNING
DASObjectStore formal PDF reporting could not prewarm the Grammateus provider.
Install or repair Grammateus and initialise the provider with:
  grammateus_report_provider install --image grammateus/report:0.8.1
Then restart dasobjectstore-server.service before rebuilding reports from the
Web interface.
WARNING
}

ensure_owned_dir() {
  local path="$1"
  local mode="$2"
  install -d -o "$service_user" -g "$service_group" -m "$mode" "$path"
}

repair_managed_tree() {
  local root="$1"
  if [[ ! -d "$root" ]]; then
    return 0
  fi

  chown "$service_user:$service_group" "$root"
  chmod 0750 "$root"
  # Never recursively traverse a live data plane from a package maintainer
  # script. Ingest/destage may create or retire payloads concurrently, and a
  # stale `find -exec` batch can both fail package configuration and rewrite
  # ownership on application-managed workspaces. The daemon creates managed
  # descendants with the service identity; legacy/adopted trees require the
  # explicit reconciliation workflow.
  if [[ -d "$root/.dasobjectstore" ]]; then
    chown "$service_user:$service_group" "$root/.dasobjectstore"
    chmod 0750 "$root/.dasobjectstore"
  fi
}

repair_marked_managed_tree() {
  local root="$1"
  if [[ ! -d "$root" ]]; then
    return 0
  fi
  if [[ ! -d "$root/.dasobjectstore" ]]; then
    cat >&2 <<WARNING
DASObjectStore left existing files below $root untouched because the profile
namespace marker is missing. Explicit profile adoption/reconciliation is
required before package configuration can manage that tree.
WARNING
    return 0
  fi
  repair_managed_tree "$root"
}

ensure_profile_layout() {
  local root="$1"
  ensure_owned_dir "$root" 0750
  if [[ -e "$root/ssd" && ! -d "$root/ssd" ]]; then
    printf 'DASObjectStore profile path %s/ssd is not a directory.\n' "$root" >&2
    exit 1
  fi
  if [[ -e "$root/hdd" && ! -d "$root/hdd" ]]; then
    printf 'DASObjectStore profile path %s/hdd is not a directory.\n' "$root" >&2
    exit 1
  fi
  if [[ ! -e "$root/ssd" ]]; then
    ensure_owned_dir "$root/ssd" 0750
  fi
  if [[ ! -e "$root/hdd" ]]; then
    install -d -o root -g root -m 0755 "$root/hdd"
  fi
}

reject_user_owned_managed_root() {
  local path="$1"
  if [[ ! -e "$path" ]]; then
    return 0
  fi

  local owner group
  owner="$(stat -c '%U' "$path")"
  group="$(stat -c '%G' "$path")"
  if [[ "$owner" != "$service_user" || "$group" != "$service_group" ]]; then
    cat >&2 <<ERROR
DASObjectStore managed root $path is owned by $owner:$group.
Managed DAS roots must be owned by $service_user:$service_group so normal users
submit jobs through dasobjectstored instead of writing directly to member disks.
Repair ownership with the formal DASObjectStore disk lockdown command before
continuing package configuration.
ERROR
    exit 1
  fi
}

ensure_group
ensure_user
ensure_web_admin_peer_membership
ensure_container_runtime_access

install -d -o "$service_user" -g "$shared_monas_group" -m 0750 /run/dasobjectstore
install -d -o "$service_user" -g "$shared_monas_group" -m 0750 /var/lib/dasobjectstore
ensure_owned_dir /var/lib/dasobjectstore/object-service 0700
ensure_owned_dir /var/lib/dasobjectstore/projection-authority 0700
ensure_owned_dir /var/lib/dasobjectstore/report-rebuild 0750
ensure_owned_dir /var/lib/dasobjectstore/telemetry 0750
ensure_owned_dir /var/log/dasobjectstore 0750
ensure_owned_dir "$product_root" 0750
ensure_owned_dir "$product_root/tls" 0750
install -d -o root -g "$service_group" -m 0750 /etc/dasobjectstore
find /etc/dasobjectstore -maxdepth 1 -type f -name '*.json' \
  -exec chgrp "$service_group" {} + \
  -exec chmod 0640 {} +
authority_retirement_projection=/etc/dasobjectstore/authority-retirement-projection-finalize-v1.json
if [[ -e "$authority_retirement_projection" || -L "$authority_retirement_projection" ]]; then
  if [[ ! -f "$authority_retirement_projection" || -L "$authority_retirement_projection" ]]; then
    echo "protected DAS authority-retirement projection is unsafe" >&2
    exit 1
  fi
  chown root:root "$authority_retirement_projection"
  chmod 0600 "$authority_retirement_projection"
fi
store_registry_state=/var/lib/dasobjectstore/stores.json
store_registry_config=/etc/dasobjectstore/stores.json
if [[ ! -e "$store_registry_state" && -f "$store_registry_config" ]]; then
  install -o "$service_user" -g "$shared_monas_group" -m 0640 \
    "$store_registry_config" "$store_registry_state"
elif [[ -f "$store_registry_state" ]]; then
  chown "$service_user:$shared_monas_group" "$store_registry_state"
  chmod 0640 "$store_registry_state"
fi
if [[ -e /run/dasobjectstore/dasobjectstored.sock ]]; then
  /usr/libexec/dasobjectstore/manage-monas-access-boundary publish-socket
fi
if [[ -f "$product_root/config.json" ]]; then
  chown root:"$service_group" "$product_root/config.json"
  chmod 0640 "$product_root/config.json"
fi
if [[ -f /etc/dasobjectstore/workspace-host.json ]]; then
  chown root:root /etc/dasobjectstore/workspace-host.json
  chmod 0640 /etc/dasobjectstore/workspace-host.json
fi
ensure_workspace_aggregate_config
ensure_workspace_nfs_config
ensure_workspace_metadata_config
reject_user_owned_managed_root "$managed_root"
ensure_profile_layout "$managed_root"
install -d -o root -g root -m 0755 "$workspace_aggregate_root"
install -d -o root -g root -m 0755 /etc/exports.d
repair_marked_managed_tree "$managed_root/ssd"
if [[ -d "$managed_root/hdd" ]]; then
  chown root:root "$managed_root/hdd"
  chmod 0755 "$managed_root/hdd"
  for root in "$managed_root"/hdd/*; do
    repair_marked_managed_tree "$root"
  done
fi

# Keep the Monas dashboard's read-only marker projection usable after package
# upgrades and retained-disk repair without exposing the DAS data plane.
/usr/libexec/dasobjectstore/prepare-monas-managed-root-traversal

if [[ -x /usr/libexec/dasobjectstore/configure-external-mount-policy ]]; then
  /usr/libexec/dasobjectstore/configure-external-mount-policy || true
fi

if command -v systemctl >/dev/null 2>&1; then
  # Package installation must not alter a live storage data plane.  Runtime
  # activation is a separately attended, Pistis-authorised operator action.
  systemctl daemon-reload || true
fi

ensure_report_provider
