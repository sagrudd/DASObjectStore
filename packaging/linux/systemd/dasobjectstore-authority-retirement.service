[Unit]
Description=DASObjectStore signed local-authority retirement
After=monas-site-trust-genesis-bootstrap.service
Requires=monas-site-trust-genesis-bootstrap.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/libexec/dasobjectstore/dasobjectstore-authority-retirement-finalize
ExecStart=/usr/libexec/dasobjectstore/dasobjectstore-authority-retirement
# The root parent must make one bounded exec transition to the unprivileged
# dasobjectstore receipt peer. Linux denies that setuid transition when
# PR_SET_NO_NEW_PRIVS is already set; the child itself cannot regain root and
# receives no authority paths or mutation capability.
NoNewPrivileges=false
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/prosopikon/das-replacement/accepted-governance.v1.json /etc/dasobjectstore/authority-retirement-projection-finalize-v1.json /opt/dasobjectstore/config.json
# The source, archive and journal must share one writable mount namespace root.
# Separate ReadWritePaths bind mounts make the required atomic rename fail with
# EXDEV even when all three directories are on the same underlying filesystem.
ReadWritePaths=/var/lib/dasobjectstore
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
