# REVIEWED TEMPLATE ONLY — not installed by package builders.
#
# Add an attended, one-use *three-role* opaque systemd handoff to the existing
# dasobjectstored.service only after the custody activation manifest is
# approved. Do not use Environment=, EnvironmentFile=, a registry, or an API
# to provide these values. The daemon accepts only files supplied by systemd in
# CREDENTIALS_DIRECTORY and consumes a hash-only marker before reading either
# handoff material or Garage.
#
# The distinct provisioner-plan credential is server-owned: its opaque filename
# is referenced as systemd-credential://<opaque-provisioner-plan-name> by the
# attended custody-admission request. It is UTF-8 key=value material with
# exactly these fields: version=1, role=provisioner, store_id,
# configuration_sha256, provisioner_identity, writer_access_key_id,
# writer_secret_access_key, reader_access_key_id, and reader_secret_access_key.
# It never traverses an ordinary API, registry, log, or persistence path.
#
# The writer and reader handoffs remain separate, opaque, one-use systemd
# credentials for the later dedicated retain operation; they are not a
# substitute for the provisioner plan. The production resolver validates all
# three roles against the sealed store definition before performing a backend
# call.
#
# Example shape only — replace all three placeholder names and sources during
# the attended transaction; never commit real names, paths, access keys, or
# secrets into this template or a unit file.
[Service]
# LoadCredentialEncrypted=<opaque-provisioner-plan-name>:<manager-held-encrypted-source>
# LoadCredentialEncrypted=<opaque-writer-name>:<manager-held-encrypted-source>
# LoadCredentialEncrypted=<opaque-reader-name>:<manager-held-encrypted-source>
