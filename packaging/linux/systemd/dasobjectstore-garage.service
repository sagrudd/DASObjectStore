[Unit]
Description=DASObjectStore managed Garage compatibility provider
Documentation=https://github.com/sagrudd/DASObjectStore
Requires=docker.service
BindsTo=dasobjectstore-storage-ready.service
After=dasobjectstore-storage-ready.service docker.service

[Service]
Type=simple
ExecStart=/usr/bin/docker compose --file /etc/dasobjectstore/garage.compose.yml --project-directory /var/lib/dasobjectstore/garage up
ExecStop=/usr/bin/docker compose --file /etc/dasobjectstore/garage.compose.yml --project-directory /var/lib/dasobjectstore/garage down
TimeoutStopSec=60s
Restart=on-failure
RestartSec=5s

# Activation remains explicit. This compatibility provider must never start
# independently of the verified managed enclosure.
