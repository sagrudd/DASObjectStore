[Unit]
Description=DASObjectStore managed storage daemon
Documentation=https://github.com/sagrudd/DASObjectStore
After=local-fs.target

[Service]
Type=simple
Slice=dasobjectstore-storage.slice
User=dasobjectstore
Group=dasobjectstore
MemoryAccounting=true
IOAccounting=true
OOMScoreAdjust=100
LogsDirectory=dasobjectstore
LogsDirectoryMode=0750
ConfigurationDirectory=dasobjectstore
ConfigurationDirectoryMode=0750
Environment=DASOBJECTSTORE_STORE_REGISTRY_PATH=/var/lib/dasobjectstore/stores.json
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/dasobjectstore.conf
ExecStartPre=+/usr/libexec/dasobjectstore/manage-monas-access-boundary pre-start
ExecStart=/usr/bin/dasobjectstored --config /etc/dasobjectstore/daemon.json
ExecStartPost=+/usr/libexec/dasobjectstore/manage-monas-access-boundary publish-socket
ExecStopPost=+/usr/libexec/dasobjectstore/manage-monas-access-boundary retire-socket
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/dasobjectstore /var/lib/dasobjectstore /var/log/dasobjectstore /srv/dasobjectstore

[Install]
WantedBy=multi-user.target
