[Unit]
Description=DASObjectStore privileged managed workspace host broker
Documentation=https://github.com/sagrudd/DASObjectStore
Requires=dasobjectstore-workspace-host.socket
BindsTo=dasobjectstore-storage-ready.service
After=local-fs.target dasobjectstore-storage-ready.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/dasobjectstore/dasobjectstore-workspace-host /etc/dasobjectstore/workspace-host.json
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN CAP_SYS_CHROOT
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN CAP_SYS_CHROOT
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/srv/dasobjectstore /etc/exports.d
