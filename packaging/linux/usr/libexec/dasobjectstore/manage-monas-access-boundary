#!/usr/bin/env bash
set -euo pipefail

root=""
if [[ "${1-}" == --test-root ]]; then
  [[ -n "${2-}" && "$2" != / ]] || exit 64
  root="$2"
  shift 2
fi
[[ $# -eq 1 ]] || exit 64
action="$1"
service_user=dasobjectstore
service_group=dasobjectstore
shared_group=mnemosyne-pistis-das
state_dir="$root/var/lib/dasobjectstore"
registry="$state_dir/stores.json"
appliance_identity="$state_dir/appliance-identity.json"
runtime_dir="$root/run/dasobjectstore"
socket="$runtime_dir/dasobjectstored.sock"

deny() { echo "DASObjectStore Monas access boundary is invalid" >&2; exit 1; }
meta() { [[ "$(stat -c %U "$1")" == "$2" && "$(stat -c %G "$1")" == "$3" && "$(stat -c %a "$1")" == "$4" ]] || deny; }
private() {
  [[ ! -e "$1" && ! -L "$1" ]] && return 0
  [[ ! -L "$1" && "$(stat -c %G "$1")" != "$shared_group" ]] || deny
  mode=$(stat -c %a "$1"); [[ "$mode" =~ ^[0-7]+$ && "${mode: -1}" == 0 ]] || deny
}
live() { ss -H -xl state listening | awk -v expected="$socket" '{for(i=1;i<=NF;i++)if($i==expected)found=1} END{exit(found?0:1)}'; }
await_live_socket() {
  if [[ -n "$root" ]]; then
    [[ -S "$socket" ]] && live
    return
  fi
  for _ in {1..100}; do
    [[ -S "$socket" ]] && live && return 0
    sleep 0.1
  done
  return 1
}
publish_appliance_identity() {
  [[ -f "$appliance_identity" && ! -L "$appliance_identity" ]] || deny
  [[ "$(stat -c %U "$appliance_identity")" == "$service_user" ]] || deny
  [[ "$(stat -c %h "$appliance_identity")" == 1 ]] || deny
  case "$(stat -c %G "$appliance_identity")" in "$service_group"|"$shared_group") ;; *) deny ;; esac
  mode=$(stat -c %a "$appliance_identity")
  [[ "$mode" =~ ^[0-7]+$ && "${mode: -1}" == 0 ]] || deny
  chgrp "$shared_group" "$appliance_identity"
  chmod 0640 "$appliance_identity"
  meta "$appliance_identity" "$service_user" "$shared_group" 640
}

getent group "$shared_group" >/dev/null || deny
[[ -d "$state_dir" && ! -L "$state_dir" ]] || deny
meta "$state_dir" "$service_user" "$shared_group" 750
[[ -f "$registry" && ! -L "$registry" ]] || deny
meta "$registry" "$service_user" "$shared_group" 640
if [[ -e "$appliance_identity" || -L "$appliance_identity" ]]; then
  [[ -f "$appliance_identity" && ! -L "$appliance_identity" ]] || deny
  case "$action" in publish-identity|publish-socket) ;; *)
    meta "$appliance_identity" "$service_user" "$shared_group" 640
  esac
fi
[[ -d "$runtime_dir" && ! -L "$runtime_dir" ]] || deny
meta "$runtime_dir" "$service_user" "$shared_group" 750
private "$state_dir/auth"
private "$root/srv/dasobjectstore"
private "$root/opt/dasobjectstore/tls"
[[ ! -e "$state_dir/pistis-grants.json" && ! -L "$state_dir/pistis-grants.json" ]] || deny

case "$action" in
  publish-identity)
    publish_appliance_identity
    ;;
  pre-start)
    [[ ! -e "$socket" && ! -L "$socket" ]] || deny
    ;;
  publish-socket)
    publish_appliance_identity
    await_live_socket || deny
    [[ -S "$socket" && ! -L "$socket" ]] || deny
    [[ "$(stat -c %U "$socket")" == "$service_user" && "$(stat -c %a "$socket")" == 660 ]] || deny
    case "$(stat -c %G "$socket")" in "$service_group"|"$shared_group") ;; *) deny ;; esac
    live || deny
    chgrp "$shared_group" "$socket"
    meta "$socket" "$service_user" "$shared_group" 660
    ;;
  retire-socket)
    [[ ! -e "$socket" && ! -L "$socket" ]] && exit 0
    [[ -S "$socket" && ! -L "$socket" ]] || deny
    meta "$socket" "$service_user" "$shared_group" 660
    ! live || deny
    unlink "$socket"
    ;;
  *) exit 64 ;;
esac
