{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dasobjectstore.mnemosyne.example/contracts/ergasterion-generated-output-binding-v1.schema.json",
  "title": "Ergasterion Generated Output Binding v1",
  "description": "DASObjectStore-owned, pre-admission binding for generated output settled through Limen. This schema does not define a public transfer route or capability exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingId", "applicationId", "hostAuthority", "prosopikonAuthority", "tenantId", "objectStoreId", "scope", "policyClass", "maxObjectBytes", "maxTotalBytes", "issuedAt", "expiresAt", "status"],
  "properties": {
    "schemaVersion": { "const": "ergasterion.generated-output-binding.v1" },
    "bindingId": { "$ref": "#/$defs/opaqueId" },
    "applicationId": { "$ref": "#/$defs/opaqueId" },
    "hostAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "authorityId", "projectId", "projectRevision"],
      "properties": {
        "mode": { "enum": ["monas", "synoptikon"] },
        "authorityId": { "$ref": "#/$defs/uuid" },
        "projectId": { "$ref": "#/$defs/opaqueId" },
        "projectRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "prosopikonAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "authorityRevision"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/uuid" },
        "authorityRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "tenantId": { "$ref": "#/$defs/uuid" },
    "objectStoreId": { "$ref": "#/$defs/opaqueId" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes", "operations"],
      "properties": {
        "prefixes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/logicalPrefix" } },
        "operations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["write", "complete_upload", "verify"] },
          "allOf": [
            { "contains": { "const": "write" } },
            { "contains": { "const": "complete_upload" } },
            { "contains": { "const": "verify" } }
          ]
        }
      }
    },
    "policyClass": { "const": "generated_data" },
    "maxObjectBytes": { "type": "integer", "minimum": 1, "maximum": 68719476736 },
    "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 274877906944 },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "status": { "const": "active" }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "logicalPrefix": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
