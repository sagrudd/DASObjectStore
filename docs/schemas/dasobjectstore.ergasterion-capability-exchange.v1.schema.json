{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ergasterion.mnemosyne.example/contracts/dasobjectstore-ergasterion-capability-exchange-v1.schema.json",
  "title": "DASObjectStore Ergasterion Capability Exchange v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "applicationId", "keyId", "audience", "issuedAt", "expiresAt", "nonce", "binding", "requestedScope", "correlationId", "proof"],
  "properties": {
    "schemaVersion": { "const": "dasobjectstore.ergasterion-capability-exchange.v1" },
    "requestId": { "$ref": "#/$defs/uuid" },
    "applicationId": { "const": "app-7e4a31c9b260" },
    "keyId": { "const": "ergasterion-ed25519-2026-07-19" },
    "audience": { "const": "ergasterion-governed-data-service" },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "binding": { "$ref": "ergasterion.object-store-binding.v2.schema.json" },
    "requestedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectStoreId", "prefixes", "operations", "maxObjectBytes", "maxTotalBytes"],
      "properties": {
        "objectStoreId": { "$ref": "#/$defs/opaqueId" },
        "prefixes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/logicalPrefix" } },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["list", "read", "verify"] } },
        "maxObjectBytes": { "type": "integer", "minimum": 1, "maximum": 68719476736 },
        "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 274877906944 }
      }
    },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "opaqueId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" },
    "logicalPrefix": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
